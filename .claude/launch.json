{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "skewvy",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "skewvy-sqlite",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=sqlite:./data/skewvy.db NODE_OPTIONS=--experimental-sqlite npx next dev -p 3100"
      ],
      "port": 3100
    },
    {
      "name": "skewvy-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    }
  ]
}
