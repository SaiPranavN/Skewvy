# ---------------------------------------------------------------------------
# Skewvy environment
# Copy to .env.local. Everything except DATABASE_URL has a working default.
# ---------------------------------------------------------------------------

# --------------------------------- database --------------------------------
# Supabase, from Project Settings → Database → Connection string → URI.
#
# Use the *Transaction pooler* (port 6543) for the app. It is the one that
# survives many short-lived serverless instances, and it is reachable over
# IPv4. Note the user is postgres.<project-ref>, not plain postgres:
#
#   postgresql://postgres.hzyvbtocibpsnavvesop:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Omit entirely for a zero-setup local SQLite file (development only — the app
# refuses to start in production without this set):
#   sqlite:./data/skewvy.db
DATABASE_URL=

# Optional TLS hardening. Without a CA the connection is still encrypted but the
# certificate is not verified, which is what every Supabase client does by
# default. Paste Supabase's CA certificate here to verify it properly.
DATABASE_CA_CERT=

# Pool sizing. Supabase counts every client against the project's budget, so
# keep this small and multiply by the number of instances you expect to run.
DATABASE_POOL_MAX=6
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=15000

# -------------------------------- supabase ---------------------------------
# Queries go over Postgres via DATABASE_URL, not through these. Storage is the
# exception: uploaded images need the HTTP API and therefore a key.
# The publishable key is safe to expose. The secret key never is: it bypasses
# every policy, so it belongs only in server-side environment variables.
NEXT_PUBLIC_SUPABASE_URL=https://hzyvbtocibpsnavvesop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Required for image uploads: files live in Supabase Storage,
# which is an HTTP service and cannot be reached over the Postgres connection.
# Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=

# ---------------------------------- app ------------------------------------
# Absolute base URL. Used for emailed links and share URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile. Without these, Cloudflare's public "always passes" test
# keys are used, and tokens are still verified server-side against Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email delivery. With no key set, messages are written to .mail/ and the link
# is printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=

# Peppers the IP hashes stored on sessions and auth tokens. Set a long random
# value in production and never rotate it casually.
IP_HASH_PEPPER=

# Comma-separated addresses that receive the admin flag when they register.
ADMIN_EMAILS=

# -------------------------------- realtime ---------------------------------
# Relay reaction events between instances over LISTEN/NOTIFY. Needed once more
# than one instance serves traffic; a single instance fans out in process.
REALTIME_PG_NOTIFY=

# LISTEN cannot run on the transaction pooler, which hands the connection back
# after every statement. Point this at the *Session pooler* (port 5432) while
# DATABASE_URL keeps using the transaction pooler above.
REALTIME_DATABASE_URL=

# --------------------------------- images ----------------------------------
# Extra hosts the Next.js image optimiser may fetch from, comma-separated. The
# Supabase Storage host is allowed automatically. Leave empty unless you paste
# image URLs from a publisher's own CDN.
IMAGE_HOSTS=
