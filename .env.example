# ---------------------------------------------------------------------------
# Skewvy environment
# Copy to .env.local for local development. Nothing here is required to run
# locally — every value has a working development default.
# ---------------------------------------------------------------------------

# Database. Omit for the zero-setup local SQLite file (requires Node 22.5+ run
# with --experimental-sqlite, which the npm scripts already pass).
#   sqlite:./data/skewvy.db
#   postgres://user:password@host:5432/skewvy
DATABASE_URL=sqlite:./data/skewvy.db

# Absolute base URL used to build emailed links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile. Without these, Cloudflare's public "always passes" test
# keys are used, and tokens are still verified server-side against Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email delivery. With no key set, messages are written to .mail/ and the link
# is printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Skewvy <onboarding@resend.dev>"

# Peppers the IP hashes stored on sessions and auth tokens. Set a long random
# value in production.
IP_HASH_PEPPER=

# Comma-separated addresses that receive the admin flag when they register.
ADMIN_EMAILS=

# Set to 1 to relay realtime events between instances via PostgreSQL
# LISTEN/NOTIFY. Requires a postgres DATABASE_URL.
REALTIME_PG_NOTIFY=

# Set to 1 to permit the demo activity simulator outside development.
# Leave empty in production.
ALLOW_SIMULATOR=
